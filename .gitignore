# ---------------------------------------------------------------
# Godot 4 (.NET / GL Compatibility)
# 官方模板 + 本项目补充。注意：*.import / *.uid 必须提交，不要忽略。
# ---------------------------------------------------------------

# Godot 4 编辑器缓存与导入数据（可完全重新生成）
.godot/
# Android 导出构建目录
/android/
.vscode/
.workbuddy/

# 旧版 Godot 3 残留（生成的导入缓存）
.import/

# 导出配置（本地构建参数，若使用签名密钥请勿提交）
export.cfg

# 导出的游戏目录 / 打包产物
/build/
/export/

# 自动生成的翻译资源（由 CSV 转换而来）
*.translation

# ---------------------------------------------------------------
# .NET / Mono
# ---------------------------------------------------------------
.mono/
data_*/
mono_crash.*.json
mono_crash.*.config
mono_crash.mem.*.blob

# ---------------------------------------------------------------
# 操作系统 / 编辑器杂项
# ---------------------------------------------------------------
# Windows
desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# JetBrains Rider / VS
.idea/
*.user
*.suo

# ---------------------------------------------------------------
# 临时文件
# ---------------------------------------------------------------
*.tmp
*.log
*.bak
*~
